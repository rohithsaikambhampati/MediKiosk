# MediKiosk Backend Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR LOCAL OR PRODUCTION SECRETS.
# NEVER COMMIT REAL CREDENTIALS OR SERVICE KEYS TO SOURCE CONTROL.

PROJECT_NAME=MediKiosk Clinical Core API
API_VERSION=v1
ENVIRONMENT=development
DEBUG=True
DEMO_MODE=True

# AI & OCR Providers (Default to deterministic local mock for 100% offline SIH demo reliability)
AI_PROVIDER=mock
OCR_PROVIDER=mock

# Database Configuration (Defaults to local SQLite; override with PostgreSQL for production)
DATABASE_URL=sqlite:///./medikiosk.db
# Example PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

# Security & Authentication (Generate secure 32+ byte string in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# File Storage
UPLOAD_DIR=./storage/documents
TEMP_DIR=./storage/temp
MAX_UPLOAD_SIZE_MB=15

# Supabase (Optional for local mode; required only when using Supabase Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
